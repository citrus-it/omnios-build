Fixes xterm-256color which seem to worked before:
https://cgit.git.savannah.gnu.org/cgit/screen.git/commit/?id=86ce25b620c52c9bdea94bf1185a274466f69b80

cat > test.sh << EOF
for i in {0..255}; do
    printf "\x1b[48;5;\${i}m%4d" \$i
    if (( (\$i + 1) % 16 == 0 )); then
        printf "\x1b[0m\n"
    fi
done
printf "\x1b[0m\n"
EOF
export TERM=xterm-256color
bash test.sh

